/.quarto/
/_site/
/_freeze/
*_files/
.Rhistory
.RData
**/.DS_Store

**/*.quarto_ipynb

# Diapos : les PDF compilés (présentation + imprimable) et les fichiers
# auxiliaires sont produits par la compilation. Les autres PDF de diapos/
# (venn.pdf, TableNormale.pdf, etc.) sont des images utilisées par les
# diapos et restent versionnés.
/diapos/Module *.pdf
/diapos/*.aux
/diapos/*.bbl
/diapos/*.bcf
/diapos/*.blg
/diapos/*.fdb_latexmk
/diapos/*.fls
/diapos/*.log
/diapos/*.nav
/diapos/*.out
/diapos/*.run.xml
/diapos/*.snm
/diapos/*.toc
/diapos/*.vrb

# Document de travail interne (relecture/suggestions) : jamais versionné,
# n'apparaît pas sur le site (voir _quarto.yml resources et diapos.qmd).
/diapos/suggestions-ameliorations.*

# Diapos annotées en classe : usage personnel, jamais versionné.
/diapos/Annotées/

# Recueil d'exercices : le PDF compilé et les fichiers auxiliaires sont
# produits par la compilation (voir recueil/compiler.sh). Le .tex,
# Evaluation.cls, les images et logo_ul.pdf restent versionnés.
/recueil/*.pdf
!/recueil/logo_ul.pdf
/recueil/*.aux
/recueil/*.fdb_latexmk
/recueil/*.fls
/recueil/*.log
/recueil/*.out
/recueil/*.synctex.gz

